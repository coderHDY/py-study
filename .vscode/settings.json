{
  "code-runner.executorMap": {
    "python": "$workspaceRoot/004_langchain/.venv/bin/python -u $fullFileName"
  },
  "code-runner.executorMapByFileExtension": {
    ".py": "$workspaceRoot/004_langchain/.venv/bin/python -u $fullFileName"
  },
  "python.defaultInterpreterPath": "${workspaceFolder}/004_langchain/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.analysis.diagnosticMode": "workspace",
  "basedpyright.analysis.diagnosticMode": "workspace",
  "basedpyright.venvPath": "${workspaceFolder}/004_langchain",
  "basedpyright.venv": ".venv"
}
